APP_ENV=development
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_DEPLOYMENT=gpt-5
CONFIDENCE_REVIEW_THRESHOLD=0.75
DEMO_OTP_ENABLED=true
# App Service Easy Auth injects this header after validating Microsoft Entra ID.
PRINCIPAL_HEADER_NAME=x-ms-client-principal
# Optional temporary sharing gate. Set only in the hosting environment.
DEMO_ACCESS_CODE=
DEMO_ACCESS_SECRET=
